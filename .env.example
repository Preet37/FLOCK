# Copy to .env and fill in. Without a key, the pipeline runs on offline rules.
ANTHROPIC_API_KEY=
FLOCK_MODEL=claude-sonnet-5-5
# FLOCK_OFFLINE=1   # force offline rules even with a key (fast, free, deterministic)
# FLOCK_LLM_TIMEOUT=30   # seconds per Claude call before a judge falls back to offline rules
