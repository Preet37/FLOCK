# Copy to .env and fill in. With nothing set, the pipeline runs on offline rules.
# FLOCK_OFFLINE=1   # force offline rules even with keys (fast, free, deterministic)
# FLOCK_LLM_TIMEOUT=30   # seconds per model call before that role falls back to offline rules

# --- providers -----------------------------------------------------------------
# local: OpenAI-compatible server (vLLM or Ollama), e.g. the GX10 over Tailscale
FLOCK_LOCAL_URL=http://127.0.0.1:11434/v1
FLOCK_LOCAL_MODEL=llama3.1:8b
# FLOCK_LOCAL_API_KEY=          # only if the server was started with an API key (vllm serve --api-key)

GROQ_API_KEY=
# FLOCK_GROQ_MODEL=llama-3.3-70b-versatile

NVIDIA_API_KEY=
# FLOCK_NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# FLOCK_NVIDIA_URL=https://integrate.api.nvidia.com/v1

ANTHROPIC_API_KEY=
FLOCK_MODEL=claude-sonnet-5-5

# --- which provider each role uses (local, groq, nvidia, anthropic, offline) ------
# FLOCK_PROVIDER=anthropic              # default for judges/writer/mapper when their own variable is unset
# FLOCK_JUDGE_PROVIDERS=local,local,groq   # one per judge: strict, operator, skeptic (one entry = all three)
# FLOCK_JUDGE_MODELS=qwen3:32b,,        # optional per-judge model ids; blank = that provider's model
# FLOCK_REVIEWER_PROVIDER=anthropic     # second opinions on the audit sample + escalation memos on splits
# FLOCK_WRITER_PROVIDER=local           # dispute drafts
# FLOCK_MAPPER_PROVIDER=local           # column mappings for unseen report layouts
# FLOCK_REVIEWER_MODEL= / FLOCK_WRITER_MODEL= / FLOCK_MAPPER_MODEL=   # optional model override per role
# FLOCK_AUDIT_RATE=0.1                  # share of panel-decided findings the reviewer double-checks
